# Public env vars exposed to the client bundle.
# Only the keys listed in `vite.config.ts` -> `PUBLIC_ENV_KEYS` get inlined into the browser bundle.
# Other vars in this file (e.g. ADMIN) stay server-side.

# Backend REST API base URL (used by src/api/config.ts).
API_BASE_URL=http://127.0.0.1:8000/api

# Django: server-side admin allowlist for `/api/admin/*` (NOT exposed to the client).
ADMIN=crystal.gym.in@gmail.com
# API_BASE_URL=https://3.83.217.146:8000/api
# API_BASE_URL=https://api.crystal-co.in/api

# Public gym sites: https://{slug}.{domain}/ (leave unset for path-only /{slug}/ in dev)
PUBLIC_SITE_DOMAIN=crystal-co.in

# Homepage tutorial video (YouTube watch/embed URL)
HOMEPAGE_TUTORIAL_VIDEO_URL=https://youtu.be/2fAGzbi3kb4

GOOGLE_CLIENT_ID=82075464207-u7th8vr315nka4udv6e42suo4juc24k5.apps.googleusercontent.com

# Marketing contact (homepage + service enquiry)
CONTACT_EMAIL=crystal.gym.in@gmail.com
CONTACT_PHONE=+91 81379 51793
CONTACT_PHONE_TEL=+918137951793

# WhatsApp contact (number with country code, no + or spaces)
WHATSAPP_PHONE=918137951793
# Pre-filled message when user clicks Chat on WhatsApp
WHATSAPP_MESSAGE=Hello I am interested in your service

# Public enquiry API paths (backend contract; must match Django routes)
MARKETING_ENQUIRY_PATH=/public/enquiries/
SERVICE_ENQUIRY_PATH=/public/service-enquiries/
