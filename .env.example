# Backend API base URL (used by src/api/config.ts)
# Website builder: POST {VITE_API_BASE_URL}/businesses/website-setup/ (Bearer) — body: CrystalWebsiteSetupPayload (see src/pages/crystal/gymClientSiteContent.ts)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Homepage tutorial video (YouTube watch/embed URL)
VITE_HOMEPAGE_TUTORIAL_VIDEO_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# Google OAuth 2.0 Client ID (Web application) for Sign in with Google
VITE_GOOGLE_CLIENT_ID=dummy-5gqdkec0f285l3v0f85tepqa3ckl7k6d.apps.googleusercontent.com

# WhatsApp contact (number with country code, no + or spaces)
VITE_WHATSAPP_PHONE=9198137951793
# Pre-filled message when user clicks Chat on WhatsApp
VITE_WHATSAPP_MESSAGE=Hello I am interested in your service
