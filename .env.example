# Public env vars exposed to the client bundle.
# Only the keys listed in `vite.config.ts` -> `PUBLIC_ENV_KEYS` are inlined into the browser bundle.

# Backend REST API base URL (used by src/api/config.ts)
# Website builder: POST {API_BASE_URL}/businesses/website-setup/ (Bearer) — body: CrystalWebsiteSetupPayload
API_BASE_URL=http://127.0.0.1:8000/api

# Public gym sites: https://{slug}.{domain}/ (leave unset for path-only /{slug}/ in dev)
PUBLIC_SITE_DOMAIN=example.com

# Homepage tutorial video (YouTube watch/embed URL)
HOMEPAGE_TUTORIAL_VIDEO_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# Google OAuth 2.0 Client ID (Web application) for Sign in with Google
GOOGLE_CLIENT_ID=dummy-5gqdkec0f285l3v0f85tepqa3ckl7k6d.apps.googleusercontent.com

# Marketing contact (homepage + service enquiry)
CONTACT_EMAIL=hello@example.com
CONTACT_PHONE=+91 00000 00000
CONTACT_PHONE_TEL=+910000000000

# WhatsApp contact (number with country code, no + or spaces)
WHATSAPP_PHONE=910000000000
# Pre-filled message when user clicks Chat on WhatsApp
WHATSAPP_MESSAGE=Hello I am interested in your service

# Optional: POST path for marketing enquiries (default /public/enquiries/)
# MARKETING_ENQUIRY_PATH=/public/enquiries/

# Optional: POST path for service / custom website enquiries (default /public/service-enquiries/)
# Mirrors backend SERVICE_ENQUIRY_EMAIL_SUBJECT for notification subject.
# SERVICE_ENQUIRY_PATH=/public/service-enquiries/

# SEO: canonical site URL (include https). Used for metadata, sitemap, and JSON-LD.
# Falls back to PUBLIC_SITE_DOMAIN when unset.
# SITE_URL=https://www.example.com

# Optional: served business image URL behaviour (when raw image_url is private).
# BUSINESS_IMAGE_USE_API_FILE=false
# BUSINESS_IMAGE_FILE_SEGMENT=file

# Optional: app base path (when hosting at a subpath, e.g. /app/).
# BASE_PATH=/
